# ==============================================================================
# SwordNex AI CRM - Environment Variables Example
# Company: SwordNex Technologies Private Limited
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swordnex_crm

# JWT Security
JWT_SECRET=super_secret_jwt_key_for_swordnex_crm_production_needs_32_bytes_min
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_for_swordnex_crm_prod
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# AI Configuration (Optional external keys - System includes built-in Intelligent Heuristic/Mock AI Engine fallback)
# Supported AI Providers: gemini, openai, anthropic, mock
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_MODEL=gemini-1.5-pro

# External Communication Adapters (Optional - System safely logs simulated dispatch if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SwordNex CRM <no-reply@swordnex.com>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
