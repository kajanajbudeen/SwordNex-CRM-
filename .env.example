# ==============================================================================
# SwordNex AI CRM — Production Environment Configuration Template
# Company: SwordNex Technologies Private Limited
# DO NOT COMMIT REAL PRODUCTION SECRETS OR VALUES TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CLIENT_URL=https://crm.yourdomain.com
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
TRUSTED_PROXY=loopback,linklocal,uniquelocal

# ------------------------------------------------------------------------------
# PostgreSQL Database (Host or Docker Internal)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# ------------------------------------------------------------------------------
POSTGRES_USER=swordnex_admin
POSTGRES_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_MIN_32_CHARS
POSTGRES_DB=swordnex_crm
DATABASE_URL=postgresql://swordnex_admin:YOUR_STRONG_DATABASE_PASSWORD_MIN_32_CHARS@database:5432/swordnex_crm?schema=public

# Docker Secrets File Alternative (Recommended for Production Compose):
# DATABASE_URL_FILE=/run/secrets/database_url

# ------------------------------------------------------------------------------
# Cryptographic JWT Authentication Secrets (Pin: HS256, Issuer & Audience)
# Generate using: openssl rand -hex 64
# ------------------------------------------------------------------------------
JWT_SECRET=GENERATE_INDEPENDENT_64_BYTE_HEX_SECRET_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET=GENERATE_INDEPENDENT_64_BYTE_HEX_SECRET_FOR_REFRESH_TOKENS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Docker Secrets File Alternative:
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret

# ------------------------------------------------------------------------------
# Razorpay Live / Test Payment Gateway
# ------------------------------------------------------------------------------
# Public Key ID (shared with frontend checkout modal):
RAZORPAY_KEY_ID=rzp_live_YOUR_ACTUAL_KEY_ID
# Secret Key (Strictly backend-only; never exposed to frontend):
RAZORPAY_KEY_SECRET=YOUR_ACTUAL_RAZORPAY_KEY_SECRET
# Webhook Secret (Configured in Razorpay Dashboard for webhook signature verification):
RAZORPAY_WEBHOOK_SECRET=YOUR_ACTUAL_RAZORPAY_WEBHOOK_SECRET

# Docker Secrets File Alternative:
# RAZORPAY_KEY_SECRET_FILE=/run/secrets/razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET_FILE=/run/secrets/razorpay_webhook_secret

# ------------------------------------------------------------------------------
# SMTP Email Service (Password Reset & Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=YOUR_SMTP_API_KEY_OR_PASSWORD
SMTP_FROM="SwordNex AI CRM <no-reply@yourdomain.com>"

# Docker Secrets File Alternative:
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# ------------------------------------------------------------------------------
# Rate Limiting & Protection Defaults
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional external LLM credentials)
# Providers: gemini, openai, anthropic, mock
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Telephony & Messaging Providers (Optional external communications)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
