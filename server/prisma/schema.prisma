datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  ADVERTISEMENT
  WEBSITE
  REFERRAL
  COLD_CALL
  TRADE_SHOW
  SOCIAL_MEDIA
  PARTNER
  EMAIL_CAMPAIGN
  CAMPAIGN
  LINKEDIN
  API
  EVENT
  OTHER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  FOLLOW_UP
  CALL
  EMAIL
  MEETING
  PREPARATION
  OTHER
}

enum ChannelType {
  EMAIL
  WHATSAPP
  SMS
  WEB_CHAT
}

enum MessageSenderType {
  AGENT
  CUSTOMER
  AI_AGENT
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
}

enum WorkflowStatus {
  SUCCESS
  RUNNING
  FAILED
  WAITING_APPROVAL
}

enum SubscriptionPlan {
  FREE_TRIAL
  STANDARD
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// -------------------------------------------------------------
// Core Organizations & Multi-tenancy
// -------------------------------------------------------------
model Organization {
  id              String             @id @default(uuid())
  name            String
  slug            String             @unique
  logoUrl         String?
  domain          String?
  plan            SubscriptionPlan   @default(FREE_TRIAL)
  status          OrganizationStatus @default(ACTIVE)
  suspendedReason String?
  isActive        Boolean            @default(true)
  settings        Json?              @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships     Membership[]
  roles           Role[]
  teams           Team[]
  leads           Lead[]
  contacts        Contact[]
  companies       Company[]
  pipelines       Pipeline[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  conversations   Conversation[]
  campaigns       Campaign[]
  workflows       AutomationWorkflow[]
  workflowRuns    WorkflowRun[]
  aiInsights      AiInsight[]
  aiAgentRuns     AiAgentRun[]
  integrations    Integration[]
  subscription    Subscription?
  payments        Payment[]
  invoices        Invoice[]
  notifications   Notification[]
  usageRecords    UsageRecord[]
  auditLogs       AuditLog[]
  consentRecords  ConsentRecord[]
  attachments     Attachment[]
  importJobs      ImportJob[]
  tickets         Ticket[]
  salesTargets    SalesTarget[]

  @@index([slug])
}

// -------------------------------------------------------------
// Identity & Access Management
// -------------------------------------------------------------
model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isActive                Boolean       @default(true)
  isEmailVerified         Boolean       @default(false)
  emailVerificationToken  String?
  tokenVersion            Int           @default(0)
  passwordResetToken      String?
  passwordResetExpiresAt  DateTime?
  globalRole              UserRole      @default(USER)
  lastLoginAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  memberships     Membership[]
  ownedLeads      Lead[]        @relation("LeadOwner")
  ownedDeals      Deal[]        @relation("DealOwner")
  ownedContacts   Contact[]     @relation("ContactOwner")
  assignedTasks   Task[]        @relation("TaskAssignee")
  activities      Activity[]    @relation("ActivityCreator")
  auditLogs       AuditLog[]
  teamMemberships TeamMember[]
  ledTeams        Team[]        @relation("TeamLeader")
  importJobs      ImportJob[]
  assignedTickets Ticket[]      @relation("TicketAssignee")
  createdTickets  Ticket[]      @relation("TicketCreator")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")
  salesTargets    SalesTarget[] @relation("UserSalesTarget")

  @@index([email])
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole     @default(USER)
  customRoleId   String?
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole     Role?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([customRoleId])
}

// -------------------------------------------------------------
// Dynamic Roles & Granular Permissions
// -------------------------------------------------------------
model Role {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  department     String?          @default("GENERAL") // SALES, SUPPORT, HR, MANAGEMENT, FINANCE, MARKETING, GENERAL
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  module    String   // LEADS, CONTACTS, COMPANIES, DEALS, TASKS, EMPLOYEES, REPORTS, SETTINGS, BILLING, WORKFLOWS, AI_CENTER, COMMS
  action    String   // VIEW, CREATE, EDIT, DELETE, APPROVE, EXPORT, ASSIGN, MANAGE
  createdAt DateTime @default(now())

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  leaderId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leader         User?        @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members        TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// -------------------------------------------------------------
// CRM Entities: Leads, Companies, Contacts
// -------------------------------------------------------------
model Lead {
  id              String        @id @default(uuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String?
  secondaryEmail  String?
  phone           String?
  mobile          String?
  fax             String?
  company         String?
  title           String?
  website         String?
  skypeId         String?
  twitterHandle   String?
  avatarUrl       String?
  status          LeadStatus    @default(NEW)
  priority        LeadPriority  @default(MEDIUM)
  source          LeadSource    @default(WEBSITE)
  industry        String?
  annualRevenue   Float?
  numberOfEmployees Int?
  rating          String?       // HOT, WARM, COLD
  emailOptOut     Boolean       @default(false)
  score           Int           @default(50)
  scoreExplanation String?
  scoreConfidence Float?        @default(0.85)
  ownerId         String?

  // Address Information
  country         String?
  address         String?
  street          String?
  city            String?
  state           String?
  zipCode         String?
  latitude        Float?
  longitude       Float?

  // Description Information
  description     String?       @db.Text

  customFields    Json?         @default("{}")
  tags            String[]      @default([])
  convertedAt     DateTime?
  convertedToContactId String?
  convertedToCompanyId String?
  convertedToDealId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities      Activity[]
  tasks           Task[]
  conversations   Conversation[]
  attachments     Attachment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, score])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, mobile])
  @@index([email])
}

model Company {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  size           String?
  website        String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  annualRevenue  Float?
  healthScore    Int?          @default(80)
  churnRisk      String?       @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  customFields   Json?         @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  attachments    Attachment[]
  tickets        Ticket[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Contact {
  id              String        @id @default(uuid())
  organizationId  String
  companyId       String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  title           String?
  department      String?
  lifecycleStage  String?       @default("LEAD")
  ownerId         String?
  healthScore     Int?          @default(85)
  lastContactedAt DateTime?
  customFields    Json?         @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner           User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  conversations   Conversation[]
  attachments     Attachment[]
  tickets         Ticket[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([companyId])
}

// -------------------------------------------------------------
// Sales Pipeline & Deals
// -------------------------------------------------------------
model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id             String       @id @default(uuid())
  pipelineId     String
  name           String
  order          Int
  winProbability Int          @default(20)
  color          String       @default("#3B82F6")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals          Deal[]

  @@index([pipelineId])
  @@index([pipelineId, order])
}

model Deal {
  id                String        @id @default(uuid())
  organizationId    String
  pipelineId        String
  stageId           String
  title             String
  amount            Float         @default(0.0)
  currency          String        @default("USD")
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  status            DealStatus    @default(OPEN)
  winLossReason     String?
  winLossCategory   String?
  forecastCategory  String?       @default("PIPELINE")
  probability       Int           @default(20)
  healthScore       Int           @default(75) // 0 - 100
  healthSummary     String?
  contactId         String?
  companyId         String?
  ownerId           String?
  tags              String[]      @default([])
  customFields      Json?         @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner             User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities        Activity[]
  tasks             Task[]
  attachments       Attachment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
}

// -------------------------------------------------------------
// Activities & Tasks
// -------------------------------------------------------------
model Activity {
  id             String       @id @default(uuid())
  organizationId String
  type           String       // CALL, EMAIL, MEETING, NOTE, STAGE_CHANGE, AI_INSIGHT, STATUS_CHANGE
  title          String
  description    String?
  metadata       Json?        @default("{}")
  leadId         String?
  contactId      String?
  companyId      String?
  dealId         String?
  createdById    String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  @@index([createdAt])
}

model Task {
  id             String        @id @default(uuid())
  organizationId String
  title          String
  description    String?
  dueDate        DateTime?
  priority       TaskPriority  @default(MEDIUM)
  status         TaskStatus    @default(PENDING)
  category       TaskCategory  @default(FOLLOW_UP)
  isRecurring    Boolean       @default(false)
  recurrenceRule String?
  assignedToId   String?
  leadId         String?
  contactId      String?
  dealId         String?
  aiSuggested    Boolean       @default(false)
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, dueDate])
}

// -------------------------------------------------------------
// Unified Communication Hub
// -------------------------------------------------------------
model Conversation {
  id             String        @id @default(uuid())
  organizationId String
  channel        ChannelType   @default(EMAIL)
  subject        String?
  status         String        @default("OPEN")
  leadId         String?
  contactId      String?
  assignedToId   String?
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([leadId])
  @@index([contactId])
}

model Message {
  id                String            @id @default(uuid())
  conversationId    String
  senderType        MessageSenderType @default(AGENT)
  senderId          String?
  body              String
  status            MessageStatus     @default(SENT)
  failureReason     String?
  externalMessageId String?
  metadata          Json?             @default("{}")
  sentAt            DateTime          @default(now())
  createdAt         DateTime          @default(now())

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// Marketing Campaigns
// -------------------------------------------------------------
model Campaign {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  type            String         @default("EMAIL") // EMAIL, SMS, MULTI_CHANNEL
  status          CampaignStatus @default(DRAFT)
  audienceSegment Json?          @default("{}")
  subject         String?
  content         String?
  scheduledAt     DateTime?
  sentCount       Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  conversionCount Int            @default(0)
  budget          Float          @default(0.0)
  spend           Float          @default(0.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

// -------------------------------------------------------------
// Automation Workflows & Engine
// -------------------------------------------------------------
model AutomationWorkflow {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  triggerType    String        // LEAD_CREATED, LEAD_UPDATED, DEAL_STAGE_CHANGED, TASK_OVERDUE, SCORE_THRESHOLD, MANUAL
  triggerConfig  Json?         @default("{}")
  conditions     Json          @default("[]")
  actions        Json          @default("[]")
  isActive       Boolean       @default(true)
  runCount       Int           @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

model WorkflowRun {
  id             String             @id @default(uuid())
  workflowId     String
  organizationId String
  triggerEvent   String
  status         WorkflowStatus     @default(RUNNING)
  inputData      Json?              @default("{}")
  executionLogs  Json?              @default("[]")
  stepResults    Json?              @default("{}")
  errorMessage   String?
  startedAt      DateTime           @default(now())
  completedAt    DateTime?

  workflow       AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
}

// -------------------------------------------------------------
// AI Center & Autonomous Agent System
// -------------------------------------------------------------
model AiInsight {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String       // LEAD, DEAL, CONTACT, COMPANY, PIPELINE, GLOBAL
  entityId       String?
  insightType    String       // SCORING, NEXT_BEST_ACTION, CHURN_RISK, DEAL_HEALTH, MEETING_SUMMARY, FORECAST, SUMMARY
  title          String
  content        String
  confidence     Float        @default(0.85)
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
}

model AiAgentRun {
  id               String       @id @default(uuid())
  organizationId   String
  agentName        String       // LEAD_RESEARCH, SALES_FOLLOWUP, CUSTOMER_ONBOARDING, RETENTION, REPORTING
  status           String       @default("PENDING") // PENDING, RUNNING, COMPLETED, WAITING_APPROVAL, REJECTED, FAILED
  prompt           String
  executionState   Json?        @default("{}")
  toolCalls        Json?        @default("[]")
  actionsPlanned   Json?        @default("[]")
  requiresApproval Boolean      @default(false)
  isApproved       Boolean      @default(false)
  approvedById     String?
  costUsd          Float        @default(0.0)
  tokensUsed       Int          @default(0)
  startedAt        DateTime     @default(now())
  completedAt      DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
}

// -------------------------------------------------------------
// Integrations, Subscriptions & Governance
// -------------------------------------------------------------
model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String       // EMAIL_SMTP, WHATSAPP, TWILIO_SMS, GOOGLE_CALENDAR, WEBHOOK
  name           String
  isEnabled      Boolean      @default(false)
  config         Json         @default("{}")
  status         String       @default("DISCONNECTED") // HEALTHY, ERROR, DISCONNECTED
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model SubscriptionPlanConfig {
  id                 String           @id @default(uuid())
  slug               String           @unique // FREE_TRIAL, STANDARD, PREMIUM
  name               String
  description        String
  monthlyPrice       Float            @default(0.0) // In INR
  yearlyPrice        Float            @default(0.0) // In INR
  currency           String           @default("INR")
  maxUsers           Int              @default(5)
  maxCustomRoles     Int              @default(5)
  maxStorageMb       Int              @default(1000)
  maxLeads           Int              @default(15000)
  maxAiTokens        Int              @default(500000)
  allowedModules     String[]         @default(["LEADS", "CONTACTS", "COMPANIES", "DEALS", "TASKS"])
  aiFeaturesEnabled  Boolean          @default(false)
  reportExportEnabled Boolean         @default(true)
  apiAccessEnabled   Boolean          @default(false)
  supportLevel       String           @default("STANDARD") // STANDARD, PRIORITY, DEDICATED
  trialDays          Int              @default(15)
  gracePeriodDays    Int              @default(3)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @unique
  plan                   SubscriptionPlan   @default(FREE_TRIAL)
  planSlug               String             @default("FREE_TRIAL")
  billingInterval        BillingInterval    @default(MONTHLY)
  status                 SubscriptionStatus @default(TRIALING)
  currency               String             @default("INR")
  price                  Float              @default(0.0)
  seatCount              Int                @default(5)
  leadLimit              Int                @default(15000)
  aiTokenLimit           Int                @default(500000)
  aiTokensUsed           Int                @default(0)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialStartsAt          DateTime?          @default(now())
  trialEndsAt            DateTime?
  gracePeriodEndsAt      DateTime?
  razorpaySubscriptionId String?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments               Payment[]
  invoices               Invoice[]
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  subscriptionId String?
  amount         Float
  currency       String        @default("INR")
  provider       String        @default("RAZORPAY") // RAZORPAY, CASHFREE, MANUAL
  orderId        String?
  paymentId      String?
  signature      String?
  status         String        @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  invoiceId      String?
  metadata       Json?         @default("{}")
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderId])
  @@index([paymentId])
}

model Invoice {
  id              String          @id @default(uuid())
  organizationId  String
  subscriptionId  String?
  invoiceNumber   String          @unique
  amount          Float
  tax             Float           @default(0.0)
  currency        String          @default("INR")
  status          String          @default("PAID") // PAID, UNPAID, VOID
  billingInterval BillingInterval @default(MONTHLY)
  planSlug        String
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  pdfUrl          String?
  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@index([organizationId])
  @@index([invoiceNumber])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("RAZORPAY")
  eventId     String   @unique
  eventType   String
  payload     Json
  status      String   @default("PROCESSED") // RECEIVED, PROCESSED, FAILED, DUPLICATE
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([provider, eventId])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  title          String
  message        String
  type           String       @default("SYSTEM") // TRIAL_EXPIRING, SUBSCRIPTION_EXPIRING, PAYMENT_FAILED, ROLE_ASSIGNED, SYSTEM
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model LoginSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String?
  ipAddress String?
  userAgent String?
  isValid   Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  metric         String       // AI_TOKENS, EMAILS_SENT, WHATSAPP_MESSAGES, API_CALLS
  quantity       Int          @default(1)
  metadata       Json?        @default("{}")
  recordedAt     DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, metric])
  @@index([recordedAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // CREATE, UPDATE, DELETE, LOGIN, EXPORT, APPROVE, TRIGGER_WORKFLOW, TRIGGER_AGENT
  entity         String       // LEAD, DEAL, CONTACT, USER, WORKFLOW, AGENT, INTEGRATION, SETTINGS
  entityId       String?
  ipAddress      String?
  userAgent      String?
  details        Json?        @default("{}")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([createdAt])
}

model ConsentRecord {
  id             String       @id @default(uuid())
  organizationId String
  email          String?
  phone          String?
  consentType    String       // MARKETING_EMAIL, SMS, WHATSAPP, DATA_PROCESSING
  status         String       @default("GRANTED") // GRANTED, REVOKED
  source         String?
  ipAddress      String?
  grantedAt      DateTime     @default(now())
  revokedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}

model Attachment {
  id             String       @id @default(uuid())
  organizationId String
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  leadId         String?
  dealId         String?
  contactId      String?
  companyId      String?
  ticketId       String?
  uploadedById   String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([dealId])
  @@index([ticketId])
}

// -------------------------------------------------------------
// Lead Import Jobs & History Tracking
// -------------------------------------------------------------
model ImportJob {
  id              String       @id @default(uuid())
  organizationId  String
  userId          String?
  fileName        String
  fileSize        Int?
  fileType        String?      // CSV, XLSX
  status          String       @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, COMPLETED_WITH_ERRORS, FAILED
  totalRows       Int          @default(0)
  validRows       Int          @default(0)
  invalidRows     Int          @default(0)
  createdCount    Int          @default(0)
  updatedCount    Int          @default(0)
  skippedCount    Int          @default(0)
  failedCount     Int          @default(0)
  strategy        String       @default("SKIP") // SKIP, UPDATE, IMPORT_ALL
  mapping         Json?        @default("{}")
  options         Json?        @default("{}")
  errorReport     Json?        @default("[]")
  summary         Json?        @default("{}")
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// -------------------------------------------------------------
// Customer Support & Ticketing System (Phase 1)
// -------------------------------------------------------------
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketChannel {
  EMAIL
  PORTAL
  PHONE
  CHAT
  WEB
  OTHER
}

model Ticket {
  id                  String         @id @default(uuid())
  ticketNumber        String
  organizationId      String
  contactId           String?
  companyId           String?
  assignedToId        String?
  createdById         String?
  subject             String
  description         String
  status              TicketStatus   @default(OPEN)
  priority            TicketPriority @default(MEDIUM)
  channel             TicketChannel  @default(EMAIL)
  category            String?        @default("GENERAL") // GENERAL, BILLING, TECHNICAL, PRODUCT, FEATURE_REQUEST
  firstResponseDueAt  DateTime?
  firstRespondedAt    DateTime?
  resolutionDueAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  csatRating          Int?           // 1 to 5 stars
  csatFeedback        String?
  tags                String[]       @default([])
  customFields        Json?          @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company             Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo          User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?          @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments            TicketComment[]
  attachments         Attachment[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assignedToId])
  @@index([contactId])
  @@index([companyId])
}

model TicketComment {
  id             String       @id @default(uuid())
  ticketId       String
  authorId       String?
  authorType     String       @default("AGENT") // AGENT, CUSTOMER, SYSTEM, AI_ASSISTANT
  content        String
  isInternal     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User?        @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([authorId])
}

// -------------------------------------------------------------
// Sales Targets & Quota Management (Phase 1)
// -------------------------------------------------------------
model SalesTarget {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?      // If null, organization-wide quota
  period         String       // e.g. "2026-Q4", "2026-10"
  targetAmount   Float
  currency       String       @default("USD")
  startDate      DateTime
  endDate        DateTime
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation("UserSalesTarget", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, period])
  @@index([userId])
}

